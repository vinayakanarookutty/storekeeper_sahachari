{
  "expo": {
    "name": "Sahachari Storekeeper",
    "slug": "storekeeper",
    "version": "3.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "storekeeper",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.corestoneinnovations.sahachariadmin",
      "buildNumber": "18",
      "appleTeamId": "C6Z3P6492T",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "UIRequiresFullScreen": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to select and upload product, service, and rental images.",
        "NSPhotoLibraryAddUsageDescription": "This app needs access to save downloaded files and product images to your photo library.",
        "NSCameraUsageDescription": "This app needs access to your camera to take photos of products, services, and rental items.",
        "NSMicrophoneUsageDescription": "This app plays audio notifications for incoming orders and bookings.",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "splash": {
      "image": "./assets/images/splashscreen2.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "versionCode": 20,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "splash": {
        "image": "./assets/images/splashscreen2.png",
        "resizeMode": "cover",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "package": "com.corestoneinnovations.sahachariadmin"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "@react-native-firebase/app/app.plugin.js",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/messaging/app.plugin.js",
      [
        "expo-notifications"
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splashscreen.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to upload product, service, and rental images.",
          "cameraPermission": "The app needs access to your camera to take photos of products, services, and rental items."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f0ee2ac-8299-455d-9c8e-94f4651c5264"
      }
    }
  }
}